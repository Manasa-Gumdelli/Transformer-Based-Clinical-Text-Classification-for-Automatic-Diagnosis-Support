{
  "random_seed": 42,
  "min_class_count": 100,
  "text_column": "transcription",
  "label_column": "medical_specialty",
  "leaky_columns_excluded": [
    "keywords",
    "sample_name",
    "description"
  ],
  "split_fractions": {
    "train": 0.7,
    "val": 0.15,
    "test": 0.15
  },
  "cv_folds": 5,
  "nb_param_grid": {
    "tfidf__ngram_range": "[(1, 1), (1, 2)]",
    "tfidf__min_df": "[2, 3, 5]",
    "tfidf__max_df": "[0.9, 0.95]",
    "clf__alpha": "[0.02, 0.05, 0.1, 0.3, 0.5, 1.0, 2.0]"
  },
  "svm_param_grid": {
    "tfidf__ngram_range": "[(1, 2), (1, 3)]",
    "tfidf__min_df": "[1, 2]",
    "clf__C": "[1, 2, 4]",
    "clf__class_weight": "[None, 'balanced']"
  },
  "transformer": {
    "model_name": "emilyalsentzer/Bio_ClinicalBERT",
    "fallback_model_name": "microsoft/BiomedNLP-PubMedBERT-base-uncased-abstract-fulltext",
    "max_seq_length": 512,
    "chunk_stride": 128,
    "train_batch_size": 8,
    "eval_batch_size": 16,
    "num_epochs": 5,
    "early_stopping_patience": 3,
    "learning_rate": 2e-05,
    "weight_decay": 0.01,
    "warmup_ratio": 0.1
  },
  "package_versions": {
    "python": "3.12.8",
    "scikit-learn": "1.5.2",
    "transformers": "4.44.2",
    "torch": "2.4.1",
    "datasets": "2.20.0",
    "pandas": "2.3.3",
    "numpy": "1.26.4"
  }
}
